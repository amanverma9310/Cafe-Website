# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- MongoDB (local: mongodb://127.0.0.1:27017/agama | Atlas: mongodb+srv://user:pass@cluster/agama) ----
MONGO_URI=

# ---- Auth ----
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- CORS ----
# Comma-separated list of allowed frontend origins (no trailing slash).
CLIENT_URL=http://localhost:5173

# ---- Cookies (optional; sensible defaults are chosen from NODE_ENV) ----
# Dev: lax / not secure. Production: none / secure (needed when Vercel and Render use different domains).
# If frontend and API share a parent domain (www.example.com + api.example.com) set COOKIE_SAMESITE=lax.
# COOKIE_SAMESITE=
# COOKIE_SECURE=
# COOKIE_DOMAIN=

# ---- Cloudinary (https://console.cloudinary.com -> Dashboard -> API Keys) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=agama

# ---- Upload limits (MB) ----
MAX_IMAGE_MB=10
MAX_PDF_MB=25
MAX_VIDEO_MB=60

# ---- Initial administrator (used by `npm run seed`) ----
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Enquiry email notifications (optional — enquiries still save to MongoDB without these) ----
# Any SMTP provider works (Gmail app password, Resend SMTP, SendGrid SMTP, your host's SMTP, etc.)
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true only if SMTP_PORT=465 (implicit TLS). Leave false for 587/STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional "From" address/name shown to recipients. Defaults to SMTP_USER if left blank.
SMTP_FROM="Agama Cafe <no-reply@yourdomain.com>"
# Every new enquiry is emailed here in full.
ADMIN_NOTIFY_EMAIL=
# Also send the person who submitted the form a short confirmation email (if they gave one).
SEND_ENQUIRY_CONFIRMATION=true

# ---- Contact-form phone validation ----
# IN (default): requires a valid 10-digit Indian mobile number (optional +91/91/0 prefix).
# INTL: accepts a broader international phone number shape instead.
PHONE_REGION=IN
